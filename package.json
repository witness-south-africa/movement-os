{
  "name": "@wsa/root",
  "version": "0.1.0",
  "description": "Witness South Africa — civic accountability platform (monorepo root).",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": "<0",
    "pnpm": "10.34.6"
  },
  "scripts": {
    "preinstall": "node scripts/verify-package-manager.mjs",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "dependencies": {},
  "pnpm": {
    "overrides": {
      "@verdaccio/local-storage-legacy>lodash": "4.18.1",
      "nx@22.7.12>axios": "1.20.0",
      "nx@22.7.12>brace-expansion": "5.0.12",
      "miniflare@4.20260730.0>sharp": "0.35.4",
      "miniflare@4.20260730.0>undici": "7.29.1",
      "nx@22.7.12>smol-toml": "1.7.2",
      "@verdaccio/config@8.3.0>js-yaml": "5.4.2",
      "@types/node@22.20.4>undici-types": "6.28.1",
      "jest-worker@30.3.0>@ungap/structured-clone": "1.4.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nx/eslint": "22.7.12",
    "@nx/eslint-plugin": "22.7.12",
    "@nx/jest": "22.7.12",
    "@nx/js": "22.7.12",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.16.2",
    "@swc/helpers": "~0.5.11",
    "@swc/jest": "~0.2.38",
    "@types/jest": "^30.0.0",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "jest": "^30.0.0",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.7.12",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "10.9.1",
    "tslib": "^2.8.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.19.0",
    "verdaccio": "^6.10.4"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  }
}
